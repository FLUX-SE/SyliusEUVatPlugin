parameters:
    reportUnmatchedIgnoredErrors: false

    level: max

    paths:
        - src
        - tests/Application/src
        - tests/Behat
        - tests/Unit

    ignoreErrors:
        - message: '/Property FluxSE\\SyliusEUVatPlugin\\Twig\\Component\\Checkout\\Address\\FormComponent::\$formView .+/'
          paths:
            - src/Twig/Component/Checkout/Address/FormComponent.php
        # Tests
        - message: '/Property Tests\\FluxSE\\SyliusEUVatPlugin\\.+Test::\$.+ \(.+\) does not accept object\./'
          paths:
            - tests/Unit/Checker/ChannelEligibilityCheckerTest.php
            - tests/Unit/Checker/VatNumberEligibilityCheckerTest.php
